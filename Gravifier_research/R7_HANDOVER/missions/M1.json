{
  "mission_id": "M1",
  "title": "The Standard",
  "act": 1,
  "role": "Teach the loop; the archive earns trust with anchors.",
  "claims": [
    "TC-SIBAL-LG-01",
    "TC-SAF1-S1-01",
    "TC-SAF1-S2-01",
    "TC-SIBAL-SCALE-01",
    "TC-BASS-SIBAL-01"
  ],
  "environment": {
    "location": "cargo_bay_aegis_corridor",
    "material": {
      "display": "SIBAL cotton-fiberglass fabric (Aegis corridor liner panels)",
      "family_key": "sibal_fabric"
    },
    "geometry": "large_sheet",
    "duct": "large",
    "ember_hint_key": "m1"
  },
  "beats": [
    {
      "id": "insertion",
      "type": "insertion",
      "duration_s": 75,
      "dialogue": [
        {
          "speaker": "OKAFOR",
          "line": "It's the standard liner. Make it quick."
        },
        {
          "speaker": "EMBER",
          "line": "Aegis corridor panels, cotton-fiberglass composite. SIBAL heritage — the archive holds two large-duct flights for this family."
        }
      ]
    },
    {
      "id": "predict",
      "type": "predict",
      "timed_s": 10,
      "prompt": "A vigorous 1-g burner. What does this fabric do in microgravity?",
      "options": [
        {
          "id": "a",
          "text": "Same or faster than on Earth",
          "earth_expectation_ref": "PROPAGATES"
        },
        {
          "id": "b",
          "text": "Slower, but keeps burning"
        },
        {
          "id": "c",
          "text": "It just dies"
        }
      ],
      "logging": "Logged, never scored; replayed at the verdict card."
    },
    {
      "id": "run_1g",
      "type": "run_1g",
      "render": {
        "flame": "teardrop_yellow_fast_climb",
        "outcome": "panel consumed"
      },
      "label": "Earth basis: 1-g ground tests"
    },
    {
      "id": "configure",
      "type": "configure",
      "chamber": "cygnus_large_duct",
      "controls": [
        {
          "name": "flow_valve",
          "note": "anchor flow ~20 cm/s or low — exact per-run values in store"
        },
        {
          "name": "direction_toggle",
          "values": [
            "concurrent",
            "opposed"
          ]
        },
        {
          "name": "ignition",
          "values": [
            "hot_wire"
          ],
          "note": "preset per apparatus"
        }
      ],
      "branches": [
        {
          "id": "concurrent_anchor",
          "conditions": {
            "direction": "concurrent",
            "flow": "anchor"
          },
          "render_state": "EXACT",
          "claim": "TC-SIBAL-LG-01",
          "animation": {
            "flame": "full_spread",
            "front_marker": {
              "rate": {
                "whitelist_key": "s5_anchor_descent",
                "display": "2.18 mm/s"
              },
              "calibration_label_on_screen": "traverse calibration",
              "second_anchor": {
                "whitelist_key": "s6_anchor_descent",
                "display": "2.64 mm/s"
              },
              "drilldown": [
                {
                  "whitelist_key": "sibal_published_rate_s5",
                  "display": "2.1 published (+4.0%)"
                },
                {
                  "whitelist_key": "sibal_published_rate_s6",
                  "display": "2.6 published (+1.6%)"
                }
              ]
            },
            "burn_timer": {
              "whitelist_key": "sibal_s1_burn_time",
              "display": "420 s class"
            },
            "gauge_clock": "one-clock timebase (sensor epoch-ms, 30.3 Hz)"
          }
        },
        {
          "id": "opposed_moderate",
          "conditions": {
            "direction": "opposed",
            "flow": "moderate"
          },
          "render_state": "CONTRADICTED",
          "claim": "TC-SAF1-S2-01",
          "animation": {
            "sequence": "flatten_tear_gutter_dark",
            "extinction_timer": {
              "whitelist_key": "sibal_s2_extinction",
              "display": "70 s"
            },
            "contrast_timer": {
              "whitelist_key": "sibal_s1_burn_time",
              "display": "420 s"
            },
            "beat_note": "The 'slower but sustained' 1-g intuition fails at scale: it didn't slow, it died."
          }
        },
        {
          "id": "low_flow_large",
          "conditions": {
            "direction": "opposed",
            "flow": "low"
          },
          "render_state": "REFUSAL",
          "claim": "TC-SIBAL-SCALE-01",
          "animation": {
            "render": "dark_chamber",
            "refusal_text": "SIBAL, opposed low flow, large duct — no NASA evidence found.",
            "named_missing_test": "a μg test of sibal_fabric at (low_1_5, normal_20_22, large) with published outcome",
            "log_gap_button": true
          }
        }
      ]
    },
    {
      "id": "run_ug",
      "type": "run_ug",
      "renders_from": "configure.branches[].render_state (honesty contract, catalog §4.4)"
    },
    {
      "id": "decide",
      "type": "decide",
      "prompt": "Corridor fire failsafe policy",
      "options": [
        {
          "id": "a",
          "text": "Auto-reverse to opposed + ramp",
          "evidence": {
            "runs": [
              "SAFFIRE1-S2"
            ],
            "chip": "MODERATE",
            "note": "one large-duct run (S2)"
          }
        },
        {
          "id": "b",
          "text": "Full flow shutdown",
          "evidence": {
            "runs": [
              "BASS-37"
            ],
            "chip": "BOUND",
            "note": "quench at low flow observed in the SMALL duct (TC-BASS-SIBAL-01); large-duct transfer = named gap — asymmetry stated"
          }
        },
        {
          "id": "c",
          "text": "N₂ flood",
          "evidence": {
            "chip": "DISFAVORED",
            "note": "EMBER flags the entrainment logs (literature key bass_suppression)"
          }
        }
      ],
      "ember_line": "I rank evidence, I don't certify designs. Choose your margins.",
      "consequence_layers": [
        "immediate animation",
        "evidence-alignment feedback from EMBER + card",
        "narrative: Okafor position shifts, queue reorders"
      ],
      "death_states": false
    },
    {
      "id": "verdict_card",
      "type": "verdict_card",
      "cards_from": "configure.branches",
      "card_fields": [
        "tc_id",
        "verdict",
        "confidence chip + dimension bars",
        "evidence rows: run_id, value_raw, class, flags, file#row (clickable)",
        "what_would_change_it",
        "calibration labels"
      ],
      "prediction_recall": "You expected …; the archive said …"
    },
    {
      "id": "field_manual",
      "type": "field_manual",
      "entry": "FM-02",
      "text": "Direction matters: opposed flow killed the large sample in 70 seconds against 420 concurrent.",
      "numbers": [
